<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_travel_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_travel_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="implied_ids" eval="[(4, ref('group_travel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_travel_file_company" model="ir.rule">
        <field name="name">Dossier voyage multi-societe</field>
        <field name="model_id" ref="model_travel_file"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
