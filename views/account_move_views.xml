<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_travel" model="ir.ui.view">
        <field name="name">account.move.form.travel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="travel_file_id"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_ocr" class="oe_highlight"
                        string="Crée OCR" type="object" invisible="ocr_is_invoiced" />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button string="OCR" type="object"
                    name="action_view_ocr"
                    class="oe_stat_button" icon="fa-plus-square" invisible="not ocr_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
