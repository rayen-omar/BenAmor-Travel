<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_ocr_invoice_list" model="ir.ui.view">
        <field name="name">ocr.invoice.list</field>
        <field name="model">ocr.invoice</field>
        <field name="arch" type="xml">
            <list string="OCR Invoices">
                <field name="name"/>
                <field name="invoice_filename"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ocr_invoice_form" model="ir.ui.view">
        <field name="name">ocr.invoice.form</field>
        <field name="model">ocr.invoice</field>
        <field name="arch" type="xml">
            <form string="OCR Invoice">

                <header>
                    <button name="action_extract_ocr"
                            type="object"
                            string="Extract with OCR"
                            class="btn-primary"
                            icon="fa-file-text-o" invisible="status != 'draft'"/>

                    <button name="action_create_invoice"
                            type="object"
                            string="create invoice"
                            class="btn-primary"
                            icon="fa-file-text-o" invisible="status != 'analyzed'"/>
                     <button name="action_parse_with_gemini"
                            type="object"
                            string="Analyze"
                            class="btn-primary"
                            icon="fa-file-text-o" invisible="status != 'text_extracted'"/>
                    <field name="status"
                       widget="statusbar"
                       statusbar_visible="draft,text_extracted,analyzed,invoiced"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Invoice name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Invoice Document">
                            <field name="type" string="Type" invisible="status=='text_extracted'"/>
                            <field name="invoice_file"
                                   filename="invoice_filename"
                                   widget="binary"
                                   string="Upload Invoice (PDF/Image)"
                                   options="{'accepted_file_extensions': '.pdf'}" invisible="type=='image'"/>
                            <field name="invoice_file"
                                   filename="invoice_filename"
                                   widget="image"
                                   string="Upload Invoice"
                                   options="{'size': [128,158], 'zoom': true, 'preview_image':'avatar_128', 'img_class': 'border rounded h-100 object-fit-contain', 'accepted_file_extensions': '.png,.jpg,.jpeg,.tif,.tiff,.bmp'}" invisible="type=='pdf'"/>

                            <field name="invoice_filename"
                                   invisible="True"/>
                        </group>
                        <group>
                            <field name="invoice_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Extracted Text">
                            <field name="extracted_text"
                                   placeholder="Click Extract with OCR to recognize invoice text..."
                                   readonly="True"
                                   nolabel="True"/>
                        </page>
                        <page string="json Text">
                            <field name="json_text"
                                   placeholder="Click Extract with OCR to recognize invoice text..."
                                   readonly="True"
                                   nolabel="True"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_ocr_invoice"
            model="ir.actions.act_window">
        <field name="name">OCR Invoices</field>
        <field name="res_model">ocr.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu -->
    <menuitem id="menu_ocr_invoice"
              name="OCR Invoices"
              parent="account.menu_finance_configuration"
              action="action_ocr_invoice"
              sequence="10"/>

</odoo>
