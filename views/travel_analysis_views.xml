<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="travel_file_view_pivot" model="ir.ui.view">
        <field name="name">travel.file.pivot</field>
        <field name="model">travel.file</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des dossiers">
                <field name="file_type" type="row"/>
                <field name="date_departure" interval="month" type="col"/>
                <field name="amount_sale" type="measure"/>
                <field name="amount_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="travel_file_view_graph" model="ir.ui.view">
        <field name="name">travel.file.graph</field>
        <field name="model">travel.file</field>
        <field name="arch" type="xml">
            <graph string="Marge" type="bar">
                <field name="date_departure" interval="month"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="travel_service_view_pivot" model="ir.ui.view">
        <field name="name">travel.service.pivot</field>
        <field name="model">travel.service</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des prestations">
                <field name="service_type" type="row"/>
                <field name="supplier_id" type="col"/>
                <field name="sale_subtotal" type="measure"/>
                <field name="cost_company" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_travel_file_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des marges</field>
        <field name="res_model">travel.file</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'not in', ('draft', 'cancel'))]</field>
    </record>

    <record id="action_travel_service_analysis" model="ir.actions.act_window">
        <field name="name">Analyse par prestation</field>
        <field name="res_model">travel.service</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <record id="action_travel_departures" model="ir.actions.act_window">
        <field name="name">Departs a venir</field>
        <field name="res_model">travel.file</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <record id="action_travel_passport_alert" model="ir.actions.act_window">
        <field name="name">Alertes passeports</field>
        <field name="res_model">travel.passenger</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('passport_state', 'in', ('expired', 'warning', 'missing'))]</field>
    </record>
</odoo>
