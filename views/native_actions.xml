<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ VENTES (natif Odoo) ============ -->
    <record id="action_travel_sale_order" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune commande</p>
            <p>Les commandes sont normalement generees depuis un dossier de voyage.</p>
        </field>
    </record>

    <record id="action_travel_out_invoice" model="ir.actions.act_window">
        <field name="name">Factures voyage</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_travel_in_payment" model="ir.actions.act_window">
        <field name="name">Encaissements clients</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer')]</field>
        <field name="context">{'default_partner_type': 'customer', 'default_payment_type': 'inbound'}</field>
    </record>

    <!-- ============ ACHATS (natif Odoo) ============ -->
    <record id="action_travel_purchase_order" model="ir.actions.act_window">
        <field name="name">Commandes fournisseurs</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_travel_in_invoice" model="ir.actions.act_window">
        <field name="name">Factures fournisseurs</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="action_travel_out_payment" model="ir.actions.act_window">
        <field name="name">Reglements fournisseurs</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'supplier')]</field>
        <field name="context">{'default_partner_type': 'supplier', 'default_payment_type': 'outbound'}</field>
    </record>

    <!-- ============ CONTACTS (natif Odoo) ============ -->
    <record id="action_travel_customer" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
    </record>

    <record id="action_travel_supplier" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank', '>', 0)]</field>
        <field name="context">{'default_supplier_rank': 1}</field>
    </record>

    <record id="action_travel_partner_all" model="ir.actions.act_window">
        <field name="name">Tous les contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ============ CONFIGURATION (natif Odoo) ============ -->
    <record id="action_travel_product" model="ir.actions.act_window">
        <field name="name">Catalogue Services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context">{'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creez vos prestations</p>
            <p>Exemples : Billet avion, Nuitee hotel, Frais de visa, Assurance voyage.</p>
        </field>
    </record>

    <record id="action_travel_pricelist" model="ir.actions.act_window">
        <field name="name">Listes de prix</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_travel_payment_term" model="ir.actions.act_window">
        <field name="name">Conditions de paiement</field>
        <field name="res_model">account.payment.term</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_travel_tax" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_travel_currency" model="ir.actions.act_window">
        <field name="name">Devises et taux</field>
        <field name="res_model">res.currency</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ ANALYSE ============ -->
    <record id="action_travel_analytic" model="ir.actions.act_window">
        <field name="name">Comptes analytiques</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_travel_analytic_line" model="ir.actions.act_window">
        <field name="name">Ecritures analytiques</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
