<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="travel_passenger_view_list" model="ir.ui.view">
        <field name="name">travel.passenger.list</field>
        <field name="model">travel.passenger</field>
        <field name="arch" type="xml">
            <list decoration-danger="passport_state == 'expired'"
                  decoration-warning="passport_state == 'warning'">
                <field name="name"/>
                <field name="file_id"/>
                <field name="pax_type"/>
                <field name="birthdate"/>
                <field name="nationality_id"/>
                <field name="passport_number"/>
                <field name="passport_expiry"/>
                <field name="passport_state"/>
                <field name="visa_state"/>
            </list>
        </field>
    </record>

    <record id="travel_passenger_view_form" model="ir.ui.view">
        <field name="name">travel.passenger.form</field>
        <field name="model">travel.passenger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="file_id"/>
                            <field name="partner_id"/>
                            <field name="pax_type"/>
                            <field name="gender"/>
                            <field name="birthdate"/>
                            <field name="nationality_id"/>
                        </group>
                        <group>
                            <field name="is_tunisian" invisible="1"/>
                            <field name="cin_number" invisible="not is_tunisian"/>
                            <field name="passport_number"/>
                            <field name="passport_expiry"/>
                            <field name="passport_state" readonly="1"/>
                            <field name="visa_state"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Remarques..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="travel_passenger_view_search" model="ir.ui.view">
        <field name="name">travel.passenger.search</field>
        <field name="model">travel.passenger</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="passport_number"/>
                <field name="file_id"/>
                <filter name="passport_issue" string="Passeport a probleme"
                        domain="[('passport_state','in',('expired','warning','missing'))]"/>
                <filter name="visa_pending" string="Visa en cours"
                        domain="[('visa_state','in',('todo','pending'))]"/>
            </search>
        </field>
    </record>

    <record id="travel_passenger_action" model="ir.actions.act_window">
        <field name="name">Liste des Voyageurs</field>
        <field name="res_model">travel.passenger</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
