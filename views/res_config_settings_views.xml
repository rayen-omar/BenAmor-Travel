<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_google_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="BenAmor Travel" name="benamor_travel">
                    <block title="OCR Configuration">
                        <setting string=" API Key"
                                 help="API key used to extract and analyze supplier invoices with Gemini.">
                            <field name="api_key"
                                   password="True"
                                   placeholder="Enter your Google API key"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>