<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste pour travel.dossier -->
    <record id="view_travel_dossier_tree" model="ir.ui.view">
        <field name="name">travel.dossier.tree</field>
        <field name="model">travel.dossier</field>
        <field name="arch" type="xml">
            <list string="Dossiers de Voyage">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire pour travel.dossier -->
    <record id="view_travel_dossier_form" model="ir.ui.view">
        <field name="name">travel.dossier.form</field>
        <field name="model">travel.dossier</field>
        <field name="arch" type="xml">
            <form string="Dossier de Voyage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir les dossiers de voyage -->
    <record id="action_travel_dossier" model="ir.actions.act_window">
        <field name="name">Dossiers de Voyage</field>
        <field name="res_model">travel.dossier</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Principal Voyages -->
    <menuitem id="menu_travel_root" 
              name="Benamor Voyage" 
              web_icon="benamor_travel,static/description/icon.png"
              sequence="20"/>

    <!-- Sous-menu Dossiers de Voyage -->
    <menuitem id="menu_travel_dossier" 
              name="Dossiers Voyages" 
              parent="menu_travel_root" 
              action="action_travel_dossier" 
              sequence="10"/>
</odoo>
