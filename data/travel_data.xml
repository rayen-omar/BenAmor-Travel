<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_travel_file" model="ir.sequence">
            <field name="name">Dossier de voyage</field>
            <field name="code">travel.file</field>
            <field name="prefix">DV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="analytic_plan_travel" model="account.analytic.plan">
            <field name="name">Dossiers de voyage</field>
        </record>

        <!-- Types de documents par defaut -->
        <record id="doc_type_passport" model="travel.document.type">
            <field name="name">Copie du passeport</field>
            <field name="sequence">10</field>
            <field name="per_passenger" eval="True"/>
        </record>
        <record id="doc_type_photo" model="travel.document.type">
            <field name="name">Photo d'identite</field>
            <field name="sequence">20</field>
            <field name="per_passenger" eval="True"/>
            <field name="file_types">visa,omra</field>
        </record>
        <record id="doc_type_visa" model="travel.document.type">
            <field name="name">Visa obtenu</field>
            <field name="sequence">30</field>
            <field name="per_passenger" eval="True"/>
            <field name="file_types">visa,omra,package</field>
        </record>
        <record id="doc_type_contract" model="travel.document.type">
            <field name="name">Contrat de voyage signe</field>
            <field name="sequence">40</field>
        </record>
        <record id="doc_type_insurance" model="travel.document.type">
            <field name="name">Attestation d'assurance</field>
            <field name="sequence">50</field>
        </record>
        <record id="doc_type_ticket" model="travel.document.type">
            <field name="name">Billet emis</field>
            <field name="sequence">60</field>
            <field name="file_types">ticket,package,omra</field>
        </record>
        <record id="doc_type_voucher" model="travel.document.type">
            <field name="name">Voucher hotel recu</field>
            <field name="sequence">70</field>
            <field name="file_types">package,omra</field>
        </record>

        <!-- Planificateur des alertes -->
        <record id="cron_travel_alerts" model="ir.cron">
            <field name="name">BenAmor Travel : alertes limites d'annulation</field>
            <field name="model_id" ref="model_travel_file"/>
            <field name="state">code</field>
            <field name="code">model._cron_travel_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
