<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_travel_voucher" model="ir.actions.report">
        <field name="name">Voucher / Fiche dossier</field>
        <field name="model">travel.file</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">benamor_travel.report_travel_voucher</field>
        <field name="report_file">benamor_travel.report_travel_voucher</field>
        <field name="binding_model_id" ref="model_travel_file"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_travel_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Voucher - <span t-field="doc.name"/></h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Client :</strong> <span t-field="doc.partner_id"/><br/>
                                <strong>Destination :</strong> <span t-field="doc.destination_id"/><br/>
                                <strong>Agent :</strong> <span t-field="doc.user_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Depart :</strong> <span t-field="doc.date_departure"/><br/>
                                <strong>Retour :</strong> <span t-field="doc.date_return"/>
                            </div>
                        </div>

                        <h4 class="mt-4">Passagers</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nom</th><th>Type</th><th>Passeport</th><th>Expiration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.passenger_ids" t-as="pax">
                                    <td><span t-field="pax.name"/></td>
                                    <td><span t-field="pax.pax_type"/></td>
                                    <td><span t-field="pax.passport_number"/></td>
                                    <td><span t-field="pax.passport_expiry"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">Prestations</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th><th>Designation</th><th>Fournisseur</th>
                                    <th>Du</th><th>Au</th><th class="text-end">Montant</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.service_ids.filtered(lambda s: not s.excluded_from_invoice)" t-as="srv">
                                    <td><span t-field="srv.service_type"/></td>
                                    <td><span t-field="srv.description"/></td>
                                    <td><span t-field="srv.supplier_id"/></td>
                                    <td><span t-field="srv.date_start"/></td>
                                    <td><span t-field="srv.date_end"/></td>
                                    <td class="text-end">
                                        <span t-field="srv.sale_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row justify-content-end">
                            <div class="col-4 text-end">
                                <strong>Total : </strong>
                                <span t-field="doc.amount_sale"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
